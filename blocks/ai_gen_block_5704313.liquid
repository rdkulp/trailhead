{% doc %}
  @prompt
    I just need to add a logo to the bottom right corner. How can I do that?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-block-{{ ai_gen_id }} {
    display: block;
    position: fixed;
    bottom: {{ block.settings.bottom_spacing }}px;
    right: {{ block.settings.right_spacing }}px;
    z-index: 100;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: {{ block.settings.max_width }}px;
  }

  .ai-logo-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-logo-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-block-{{ ai_gen_id }} {
      bottom: {{ block.settings.mobile_bottom_spacing }}px;
      right: {{ block.settings.mobile_right_spacing }}px;
      max-width: {{ block.settings.mobile_max_width }}px;
    }
  }
{% endstyle %}

<div class="ai-logo-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.logo %}
    {% if block.settings.logo_link %}
      <a href="{{ block.settings.logo_link }}">
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ block.settings.logo.alt | escape }}"
          class="ai-logo-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
        >
      </a>
    {% else %}
      <img
        src="{{ block.settings.logo | image_url: width: 400 }}"
        alt="{{ block.settings.logo.alt | escape }}"
        class="ai-logo-image-{{ ai_gen_id }}"
        loading="lazy"
        width="{{ block.settings.logo.width }}"
        height="{{ block.settings.logo.height }}"
      >
    {% endif %}
  {% else %}
    <div class="ai-logo-placeholder-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Logo corner",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "header",
      "content": "Desktop position"
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "right_spacing",
      "label": "Right spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Mobile position"
    },
    {
      "type": "range",
      "id": "mobile_bottom_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_right_spacing",
      "label": "Right spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_max_width",
      "label": "Maximum width",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Logo corner"
    }
  ]
}
{% endschema %}
